# Get these free at https://develop.battle.net/access/clients  (Create Client, any name, redirect URL can be http://localhost)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# EU PvP, Horde
REGION=eu
RULESET=1
FACTION=horde

# Blizzard updates auction data about once an hour
INTERVAL_MINUTES=60

# 127.0.0.1 = only this PC. Use 0.0.0.0 to open it from your phone on the same Wi-Fi.
HOST=127.0.0.1
PORT=5000
